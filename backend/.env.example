# ============================================================================
# CONFIGURATION ENVIRONNEMENT - FelxPOS Backend
# ============================================================================

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/felxpos_dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=felxpos_dev
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRATION=7d

# Cloudflare R2 (Archivage NF525)
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=nf525-archives
R2_REGION=auto

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Signature & Encryption (NF525)
SIGNING_KEY=your_signing_key_for_nf525_documents_change_this
ENCRYPTION_KEY=your_encryption_key_32_chars_min

# Email (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
EMAIL_FROM=noreply@felxpos.com

# Logs
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000,https://app.felxpos.com

# Conformité NF525
NF525_VERIFICATION_INTERVAL=3600000
NF525_AUTO_CLOSURE_ENABLED=true
NF525_CLOSURE_TIME=23:59:00
NF525_ARCHIVE_RETENTION_YEARS=6
