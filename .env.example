# ============================================================================
# CONFIGURATION ENVIRONNEMENT - FelxPOS
# ============================================================================
# IMPORTANT : Copiez ce fichier vers .env et remplacez les valeurs
#             cp .env.example .env

# Base de données PostgreSQL
DB_PASSWORD=postgres123

# JWT & Sécurité (NF525)
# IMPORTANT: Changez ces valeurs en production !
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
SIGNING_KEY=your_signing_key_for_nf525_documents_change_this

# Supabase (REQUIS pour l'authentification)
# Obtenez ces valeurs depuis : https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Cloudflare R2 (REQUIS pour l'archivage NF525)
# Obtenez ces valeurs depuis : https://dash.cloudflare.com/r2
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=nf525-archives
